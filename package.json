{
    "name": "express-spell",
    "version": "0.1.0",
    "private": true,
    "description": "Spell-checking demo using trigram lookup and Levenshtein distance in PostgreSQL",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "node ./bin/www",
        "db:migrate": "sequelize-cli db:migrate",
        "db:seed": "node ./bin/seed_database.js",
        "test": "node --test"
    },
    "dependencies": {
        "cookie-parser": "^1.4.7",
        "debug": "^4.4.3",
        "express": "^5.2.1",
        "http-errors": "^2.0.1",
        "morgan": "^1.12.1",
        "pg": "^8.23.0",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.8"
    },
    "devDependencies": {
        "sequelize-cli": "^6.6.5"
    },
    "overrides": {
        "sequelize": {
            "uuid": "^11.1.1"
        }
    }
}
